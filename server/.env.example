# Uapi 翻译接口的 API Key（从 https://uapis.cn 注册获取）
# 复制本文件为 .env 并填入你的 Key
UAPI_API_KEY=your_api_key_here

# 百度翻译开放平台（https://fanyi-api.baidu.com 注册，开发者信息页获取）
# APP ID 与密钥两个值都需要
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# DeepL API（https://www.deepl.com/zh/pro-api 注册）
# Free 版 Auth Key 以 :fx 结尾
DEEPL_API_KEY=

# 后端服务端口
PORT=3000

# 前端地址（用于 CORS 白名单）
WEB_ORIGIN=http://localhost:5173
